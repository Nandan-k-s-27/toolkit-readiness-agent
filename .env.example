# ==========================================
# Toolkit Readiness Research Agent - Secrets
# ==========================================

# 1. Google Gemini API Key (Free tier from https://aistudio.google.com/)
GEMINI_API_KEY=

# 2. Anthropic API Key (Optional alternative)
# ANTHROPIC_API_KEY=

# 3. LLM Configuration
LLM_PROVIDER=gemini
MODEL=gemini-3.5-flash-lite

# 4. Search Configuration (defaults to free direct DuckDuckGo if left blank)
SEARCH_BACKEND=direct
# COMPOSIO_API_KEY=

# 5. Repository URL for the web page
REPO_URL=https://github.com/Nandan-k-s-27/toolkit-readiness-agent
